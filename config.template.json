{
    "log": {
      "loglevel": "warning"
    },
    "inbounds": [
      {
        "port": 443,
        "protocol": "vless",
        "settings": {
          "clients": [
            { "id": "${CLIENT_UUID_1}" },
            { "id": "${CLIENT_UUID_2}" },
            { "id": "${CLIENT_UUID_3}" },
            { "id": "${CLIENT_UUID_4}" },
            { "id": "${CLIENT_UUID_5}" }
          ],
          "decryption": "none"
        },
        "streamSettings": {
          "network": "grpc",
          "security": "reality",
          "realitySettings": {
            "show": false,
            "dest": "${DEST_DOMAIN}:443",
            "target": "${DEST_DOMAIN}:443",
            "xver": 0,
            "serverNames": [
              "${DEST_DOMAIN}"
            ],
            "privateKey": "${PRIVATE_KEY}",
            "shortIds": [
              "${SHORT_ID}"
            ]
          },
          "grpcSettings": {
            "serviceName": "${GRPC_SERVICE_NAME}"
          }
        }
      }
    ],
    "outbounds": [
      {
        "protocol": "freedom",
        "tag": "direct"
      }
    ]
  }
  